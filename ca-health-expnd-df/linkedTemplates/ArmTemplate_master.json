{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ca-health-expnd-df"
		},
		"ls_ablob_cahealthexpnd26ablob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_ablob_cahealthexpnd26ablob'"
		},
		"ls_adls_cahealthexpnd26dl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_cahealthexpnd26dl'"
		},
		"ls_ca_health_expnd_ws_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'ls_ca_health_expnd_ws'"
		},
		"ls_adls_cahealthexpnd26dl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://cahealthexpnd26dl.dfs.core.windows.net/"
		},
		"ls_ca_health_expnd_ws_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0807-213311-mzwnlyvu"
		},
		"ls_http_cahealthexpnd26_source_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().sourceBaseURL}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ca-health-expnd-df_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_ablob_cahealthexpnd26ablob_connectionString": {
						"value": "[parameters('ls_ablob_cahealthexpnd26ablob_connectionString')]"
					},
					"ls_adls_cahealthexpnd26dl_accountKey": {
						"value": "[parameters('ls_adls_cahealthexpnd26dl_accountKey')]"
					},
					"ls_ca_health_expnd_ws_accessToken": {
						"value": "[parameters('ls_ca_health_expnd_ws_accessToken')]"
					},
					"ls_adls_cahealthexpnd26dl_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_cahealthexpnd26dl_properties_typeProperties_url')]"
					},
					"ls_ca_health_expnd_ws_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_ca_health_expnd_ws_properties_typeProperties_existingClusterId')]"
					},
					"ls_http_cahealthexpnd26_source_properties_typeProperties_url": {
						"value": "[parameters('ls_http_cahealthexpnd26_source_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}